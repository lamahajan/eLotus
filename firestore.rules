rules_version = '2';

// EduNest Parent App + Teacher App - Firestore security rules (exam marks, notices, class notices: EduNest 1.0.53, web apps 1.6).
// Paste this whole file in Firebase console > Firestore Database > Rules, then press Publish.
//
// Who is who (the claims are put on every login by the school's EduNest server):
//   parent   token.r == 'p', token.a = admission numbers of the family's children, token.s = their section ids (e.g. 5TH-A)
//   teacher  token.r == 't', token.s = section ids the teacher teaches / is class teacher of
// EduNest itself writes with a service account, which is not bound by these rules.
// Nobody can list a collection: every read is one document by its id.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isParent() { return signedIn() && request.auth.token.r == 'p'; }
    function isTeacher() { return signedIn() && request.auth.token.r == 't'; }
    function secOf(id) { return id.split('_')[0]; }                 // homework id = <secId>_<yyyy-mm-dd>
    function mySection(id) { return secOf(id) in request.auth.token.s; }

    // Login helpers: admission no -> family account, teacher login name -> teacher account. Nothing personal inside.
    match /loginIndex/{adm} { allow get: if true; allow list, write: if false; }
    match /tLogin/{user}    { allow get: if true; allow list, write: if false; }

    // School name / app name (shown on the login screen).
    match /meta/{doc}       { allow get: if true; allow list, write: if false; }

    // A parent reads only their own children.
    match /students/{adm} {
      allow get: if isParent() && adm in request.auth.token.a;
      allow list, write: if false;
    }

    // A teacher reads only their own record (sections, subjects).
    match /teachers/{uid} {
      allow get: if isTeacher() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Homework: one document per section per day, subjects in a map.
    match /homework/{id} {
      function me() { return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data; }
      // subjects this teacher may write in this section: own subjects there, plus every subject of the class for the class teacher
      function allowed(id) {
        let t = me();
        let own = t.secs.get(secOf(id), []);
        return t.ct == secOf(id) ? own.concat(t.ctSubj.keys()) : own;
      }
      function shapeOk(id) {
        return request.resource.data.keys().hasOnly(['subjects', 'secId', 'date', 'upd'])
          && request.resource.data.secId == secOf(id)
          && request.resource.data.date == id.split('_')[1]
          && request.resource.data.subjects is map;
      }

      allow get: if (isParent() || isTeacher()) && mySection(id);
      allow list: if false;
      allow create: if isTeacher() && mySection(id) && shapeOk(id)
        && request.resource.data.subjects.keys().hasOnly(allowed(id));
      allow update: if isTeacher() && mySection(id) && shapeOk(id)
        && request.resource.data.subjects.diff(resource.data.subjects).affectedKeys().hasOnly(allowed(id));
      allow delete: if false;
    }

    // Exam marks (Teacher App <-> EduNest Mark Entry). Written by EduNest: mkcfg (students, subjects, max marks of a section).
    match /mkcfg/{secId} {
      allow get: if isTeacher() && secId in request.auth.token.s;
      allow list, write: if false;
    }
    // One sheet per section / session / term / assessment / subject: id = <secId>~<session>~<term>~<code>~<subjectKey>
    match /marks/{id} {
      function parts(x) { return x.split('~'); }
      function mayWrite(sec, subj) {
        let t = get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
        return subj in t.secs.get(sec, []) || (t.ct == sec && subj in t.ctSubj.keys());
      }
      function sheetOk(x) {
        let d = request.resource.data;
        return parts(x).size() == 5
          && d.keys().hasOnly(['secId', 'session', 'term', 'code', 'subj', 'm', 'upd', 'by', 'src', 'ul'])
          && d.secId == parts(x)[0] && d.subj == parts(x)[4] && d.m is map && d.m.size() <= 200
          && d.upd == request.time && d.src == 't' && d.by is string;
      }
      allow get: if isTeacher() && parts(id).size() == 5 && parts(id)[0] in request.auth.token.s;
      allow list, delete: if false;
      // Lock: a mark that is already saved can be changed or removed only if EduNest unlocked that student (ul.{adm} == true).
      // A teacher can never add to `ul`, only lose entries (re-lock after saving). New cells (blank before) are always allowed.
      function lockOk() {
        let d = request.resource.data;
        return resource == null
          ? !('ul' in d)
          : (d.m.diff(resource.data.m).changedKeys().hasOnly(resource.data.get('ul', {}).keys())
             && resource.data.m.diff(d.m).removedKeys().hasOnly(resource.data.get('ul', {}).keys())
             && resource.data.get('ul', {}).diff(d.get('ul', {})).addedKeys().size() == 0
             && resource.data.get('ul', {}).diff(d.get('ul', {})).changedKeys().size() == 0);
      }
      allow create, update: if isTeacher() && sheetOk(id) && lockOk() && parts(id)[0] in request.auth.token.s && mayWrite(parts(id)[0], parts(id)[4]);
    }

    // Notices from the school (EduNest > Cloud Sync > Parent App > Notices): one document, written by EduNest only.
    // notices/principal: school-wide notices typed by the Principal in the Teacher App (claim pr == '1', given by EduNest
    // to teachers whose EduNest login role is Principal / Administrator).
    match /notices/{doc} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create, update: if doc == 'principal' && isTeacher() && request.auth.token.pr == '1'
        && request.resource.data.keys().hasOnly(['list', 'upd']) && request.resource.data.list is list && request.resource.data.list.size() <= 30;
    }

    // Class notices posted by teachers: one document per section, n.<teacher uid> = {name, list:[...]}.
    // Parents of that section and its teachers read it; a teacher changes only their own entry, only in their own sections.
    match /tnotice/{secId} {
      function mineOk() {
        let n = request.resource.data.n;
        return !(request.auth.uid in n) || (n[request.auth.uid] is map && n[request.auth.uid].keys().hasOnly(['name', 'list'])
          && n[request.auth.uid].list is list && n[request.auth.uid].list.size() <= 20);
      }
      function shape() {
        return request.resource.data.keys().hasOnly(['secId', 'upd', 'n']) && request.resource.data.secId == secId && request.resource.data.n is map;
      }
      allow get: if (isParent() || isTeacher()) && secId in request.auth.token.s;
      allow list, delete: if false;
      allow create: if isTeacher() && secId in request.auth.token.s && shape() && mineOk()
        && request.resource.data.n.keys().hasOnly([request.auth.uid]);
      allow update: if isTeacher() && secId in request.auth.token.s && shape() && mineOk()
        && request.resource.data.n.diff(resource.data.n).affectedKeys().hasOnly([request.auth.uid]);
    }

    // everything else: closed
    match /{other=**} { allow read, write: if false; }
  }
}
