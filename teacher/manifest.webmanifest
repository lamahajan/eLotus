    },
    {
      "name": "Exam Marks",
      "short_name": "Marks",
      "description": "Enter and review exam marks",
      "url": "./#marks",
      "icons": [{ "src": "../icons/teacher-192.png", "sizes": "192x192" }]
    }
  ]
